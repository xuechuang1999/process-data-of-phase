&EXT_RESTART
#RESTART_FILE_NAME PROJECT-1.restart 
#RESTART_COUNTERS F
#RESTART_THERMOSTAT F
#RESTART_VEL T
#RESTART_CONSTRAINT F
#RESTART_DEFAULT F
#RESTART_POS T
&END EXT_RESTART

&GLOBAL
 PROJECT PROJECT
 RUN_TYPE MD #GEO_OPT
 PRINT_LEVEL MEDIUM
 PREFERRED_DIAG_LIBRARY SL
&END GLOBAL



           
&MOTION
        # &CONSTRAINT
        #        &FIXED_ATOMS
        #                LIST 145..272
        #        &END FIXED_ATOMS
        # &END CONSTRAINT





         &MD
           #DISPLACEMENT_TOL  100
           ENSEMBLE NVT
           STEPS 500000
           TIMESTEP 1.0
           TEMPERATURE 3000
           TEMP_TOL 100.0
           COMVEL_TOL 1.0E-8
             &THERMOSTAT
              # REGION MOLECULE
             &NOSE
              LENGTH 4 # CPMD
              YOSHIDA 9 # 3 5 7 9 15 25 125#
              TIMECON 200.
              MTS 2
             &END NOSE
             &END THERMOSTAT
          &END MD
          &PRINT
            &RESTART
              &EACH
                MD 1
              &END
            &END
            &RESTART_HISTORY  SILENT
              &EACH
                MD 10
              &END EACH
                ADD_LAST  NO
                COMMON_ITERATION_LEVELS               0
                FILENAME
              &END RESTART_HISTORY
              &TRAJECTORY
              &EACH
               MD 1
              &END EACH
              &END TRAJECTORY
              &VELOCITIES
              &EACH
              MD 1 #500000
              &END EACH
               &END VELOCITIES
            &END PRINT 
&END MOTION



&FORCE_EVAL
         &DFT
                   BASIS_SET_FILE_NAME /gs/home/xuechuang/BASIS_SET
                     POTENTIAL_FILE_NAME /gs/home/xuechuang/GTH_POTENTIALS
                        LSD
                           MULTIPLICITY 1
                           # SURFACE_DIPOLE_CORRECTION T
                                PLUS_U_METHOD LOWDIN
                                  &MGRID
                                             NGRIDS 5
                                                &RS_GRID


   # DISTRIBUTION_TYPE REPLICATED
   &END RS_GRID
   CUTOFF 500
   COMMENSURATE
  &END MGRID
  &QS
   EXTRAPOLATION ASPC
   EXTRAPOLATION_ORDER 3
   EPS_DEFAULT 1.0E-12
   # MAP_CONSISTENT
#########################contrl spin
#   &DDAPC_RESTRAINT
#    ATOMS 145  #number of one atom
#    STRENGTH 2.0
#    TARGET 1.0
#    TYPE_OF_DENSITY SPIN
#   &END DDAPC_RESTRAINT
#   &MULLIKEN_RESTRAINT
#    ATOMS 289
#    TARGET -1.0
#   &END MULLIKEN_RESTRAINT
  &END QS
  &SCF
   EPS_SCF 2.0E-6
   MAX_SCF 200
   SCF_GUESS RESTART 
#########################calculation configuration for metal close OT
#   ADDED_MOS 500
#   CHOLESKY INVERSE
#   &SMEAR  ON
#    METHOD FERMI_DIRAC
#    ELECTRONIC_TEMPERATURE [K] 300
#   &END SMEAR
#   &DIAGONALIZATION
#    ALGORITHM STANDARD
#   &END DIAGONALIZATION
#   &MIXING
#    METHOD BROYDEN_MIXING
#    ALPHA   0.1
#    BETA    1.5
#    NBROYDEN  8
#   &END 
   &OUTER_SCF
    MAX_SCF 20
    OPTIMIZER DIIS
    STEP_SIZE 0.15
    EPS_SCF 2.0E-6
   &END OUTER_SCF
   &OT T 
    MINIMIZER DIIS
    PRECONDITIONER FULL_ALL
    ENERGY_GAP 0.001
   &END OT
  &END SCF
  &XC
   &XC_FUNCTIONAL PBE
   &END XC_FUNCTIONAL
   &XC_GRID
    XC_SMOOTH_RHO NN10 
    XC_DERIV SPLINE2_smooth
   &END XC_GRID
  &END XC
 &END DFT
 &SUBSYS
  &CELL
   ABC 14.2119 14.2119 12.5000
  &END CELL
#96atoms
&TOPOLOGY
  COORD_FILE_FORMAT CIF
  COORD_FILE_NAME SnO2-supercell-3x3x4.cif
&END TOPOLOGY
&KIND C 
   BASIS_SET  DZVP-MOLOPT-GTH
   POTENTIAL GTH-PBE-q4
  &END KIND
  &KIND H
   BASIS_SET   DZVP-MOLOPT-GTH-q1
   POTENTIAL GTH-PBE-q1
  &END KIND
  &KIND Sn
   BASIS_SET   DZVP-MOLOPT-SR-GTH
   POTENTIAL GTH-PBE-q4
  &END KIND

  
  &KIND Cu
   BASIS_SET  DZVP-MOLOPT-SR-GTH
   POTENTIAL GTH-PBE-q11
   &DFT_PLUS_U ON
    L 2
    U_MINUS_J [eV] 6.0
    U_RAMPING [eV] 0
   &END DFT_PLUS_U
  &END KIND
  &KIND O
   BASIS_SET  DZVP-MOLOPT-SR-GTH
   POTENTIAL GTH-PBE-q6
 &END KIND
  &KIND N
   BASIS_SET  DZVP-MOLOPT-SR-GTH
   POTENTIAL GTH-PBE-q5
  &END KIND
  &KIND Ag
   BASIS_SET  TZVP-MOLOPT-SR-GTH
   POTENTIAL GTH-PBE-q11
  &END KIND
 &END SUBSYS
&END FORCE_EVAL
